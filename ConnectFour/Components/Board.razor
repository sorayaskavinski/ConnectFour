@using ConnectFour
@using System.Drawing
@inject GameState State

<!-- Tag <style> reativa -->
<style>
    :root {
        --board-bg: @ColorTranslator.ToHtml(BoardColor);
        --player1: @ColorTranslator.ToHtml(Player1Color);
        --player2: @ColorTranslator.ToHtml(Player2Color);
    }
</style>

<!-- Seletor de Cores das Peças -->
<div class="color-picker-container" style="margin-bottom: 15px; display: flex; gap: 20px; align-items: center;">
    <label style="display: flex; align-items: center; gap: 8px;">
        <strong>Jogador 1:</strong>
        <input type="color" 
               value="@ColorToHex(Player1Color)" 
               @onchange='(e) => UpdatePlayer1Color(e.Value?.ToString())' />
    </label>

    <label style="display: flex; align-items: center; gap: 8px;">
        <strong>Jogador 2:</strong>
        <input type="color" 
               value="@ColorToHex(Player2Color)" 
               @onchange='(e) => UpdatePlayer2Color(e.Value?.ToString())' />
    </label>
</div>

<nav>
    @for (byte i = 0; i < 7; i++)
    {
        var col = i;
        <span title="Click to play a piece" @onclick="() => PlayPiece(col)">🔽</span>
    }
</nav>

<article>
    @winnerMessage <button style="@ResetStyle" @onclick="ResetGame">Reset the game</button>
    <br />
    <span class="alert-danger">@errorMessage</span>
    <span class="alert-info">@CurrentTurn</span>
</article>

<div>
    <div class="board">
    @for (var i = 0; i < 42; i++)
    {
        <span class="container">
            <span></span>
        </span>
    }
    </div>
    @for (var i = 0; i < 42; i++)
    {
       <span class="@pieces[i]"></span>
    }
</div>

@code {
    [Parameter]
    public Color BoardColor { get; set; } = ColorTranslator.FromHtml("yellow");

    [Parameter]
    public Color Player1Color { get; set; } = ColorTranslator.FromHtml("red");

    [Parameter]
    public Color Player2Color { get; set; } = ColorTranslator.FromHtml("blue");

    private string[] pieces = new string[42];
    private string winnerMessage = string.Empty;
    private string errorMessage = string.Empty;

    private string CurrentTurn => string.IsNullOrEmpty(winnerMessage) ? $"Player {State.PlayerTurn}'s Turn" : "";
    private string ResetStyle => string.IsNullOrEmpty(winnerMessage) ? "display: none;" : "";

    protected override void OnInitialized()
    {
        ResetGame();
    }

    private void UpdatePlayer1Color(string? hex)
    {
        if (!string.IsNullOrEmpty(hex))
        {
            Player1Color = ColorTranslator.FromHtml(hex);
            StateHasChanged(); // Força a re-renderização das cores na tela
        }
    }

    private void UpdatePlayer2Color(string? hex)
    {
        if (!string.IsNullOrEmpty(hex))
        {
            Player2Color = ColorTranslator.FromHtml(hex);
            StateHasChanged(); // Força a re-renderização das cores na tela
        }
    }

    private void PlayPiece(byte col)
    {
        if (!string.IsNullOrEmpty(winnerMessage))
            return;

        errorMessage = string.Empty;

        try
        {
            var player = State.PlayerTurn;
            var turn = State.CurrentTurn;
            var landingRow = State.PlayPiece(col);
            
            pieces[turn] = $"player{player} col{col} drop{landingRow}";

            if (State.CheckForWin() != GameState.WinState.No_Winner)
            {
                winnerMessage = State.CheckForWin() switch
                {
                    GameState.WinState.Player1_Wins => "Player 1 Wins!",
                    GameState.WinState.Player2_Wins => "Player 2 Wins!",
                    GameState.WinState.Tie => "It's a tie!",
                    _ => ""
                };
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ResetGame()
    {
        State.ResetBoard();
        pieces = new string[42];
        winnerMessage = string.Empty;
        errorMessage = string.Empty;
    }

    private string ColorToHex(Color color)
    {
        return $"#{color.R:X2}{color.G:X2}{color.B:X2}";
    }
}